# LaTablée environment — copy to .env and fill in.
# Everything here is optional except LATABLEE_SECRET_KEY.

# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
LATABLEE_SECRET_KEY=CHANGE-ME-to-a-long-random-string

# Database — SQLite default; for the Postgres compose profile use:
# LATABLEE_DATABASE_URL=postgresql://latablee:posablee@db:5432/latablee
# LATABLEE_DATABASE_URL=sqlite:///./data/latablee.db

# Frontend origin (used for invite links)
LATABLEE_PUBLIC_ORIGIN=http://localhost:3000
LATABLEE_CORS_ORIGINS=http://localhost:3000

# Serve the web UI under a subpath (empty = root). Needed behind some reverse proxies.
NEXT_PUBLIC_BASE_PATH=

# Optional: preconfigure the AI (any OpenAI-compatible endpoint; can also be set in UI)
# LATABLEE_LLM_BASE_URL=
# LATABLEE_LLM_API_KEY=
# LATABLEE_LLM_MODEL=gpt-4o-mini